{
  "env": {
    "CLAUDE_CODE_DISABLE_TERMINAL_TITLE": "1"
  },
  "permissions": {
    "allow": [
      "Read",
      "Write",
      "Edit",
      "Glob",
      "Grep",
      "Bash(endless-cli *)",
      "Bash(curl*localhost:15702*)",
      "Bash(curl*localhost:17175*)",
      "Bash(curl*127.0.0.1:17175*)",
      "Bash(*llm-player*python*actions.py*)",
      "Bash(gh *)",
      "Bash(cd /c/code/*cargo *)",
      "Bash(cd /c/code/*git *)",
      "Bash(cd /c/code/*wc *)",
      "Bash(ls *)",
      "Bash(pwsh -NoProfile -File *)",
      "Bash(cargo *)",
      "Bash(git *)",
      "Bash(k3sc *)",
      "Bash(dotnet *)",
      "Bash(cp *)",
      "Bash(mv *)",
      "Bash(mkdir *)",
      "Bash(tasklist)",
      "Bash(tasklist *)",
      "Bash(tail *)",
      "Bash(head *)",
      "Bash(cat *)",
      "Bash(grep *)",
      "Bash(wc *)",
      "Bash(python *)",
      "Bash(DEBATE_AGENT=*)",
      "Bash(export DEBATE_AGENT=*)",
      "Bash(cd *&&*)",
      "WebFetch",
      "WebSearch"
    ],
    "deny": [
      "~/.claude/unsanitized/**"
    ],
    "filePermissions": {
      "denyRules": [
        ".env",
        ".env.*",
        "**/.env",
        "**/secrets/**",
        "**/*.key",
        "**/*.pem",
        "**/credentials/**"
      ]
    }
  },
  "model": "claude-opus-4-6",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "powershell.exe -ExecutionPolicy Bypass -NoProfile -File \"$USERPROFILE/.claude/hooks/Hook-SessionStart-Skills.ps1\""
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Task|Agent|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python \"$USERPROFILE/.claude/hooks/Hook-PreToolUse-Blocked.py\""
          }
        ]
      }
    ],
    "PostToolUse": []
  },
  "enabledPlugins": {
    "rust-analyzer-lsp@claude-plugins-official": true
  },
  "spinnerVerbs": {
    "mode": "replace",
    "verbs": [
      ""
    ]
  },
  "effortLevel": "medium",
  "autoUpdatesChannel": "latest",
  "ENABLE_LSP_TOOL": "1"
}
